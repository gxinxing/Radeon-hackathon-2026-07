[4.765431, "o", "\r\n>>> Step 3: E2E Pipeline — NL → DSL → Canonicalize → Validate → Transpile\r\n"]
[4.76547, "o", "----------------------------------------------------------------\r\n"]
[5.543028, "o", "  Strategy: BTC_EMA_Crossover\r\n  Canonicalization repairs: 3\r\n    strategy.risk.max_open_trades: None -> 3 (default_fill)\r\n    strategy.risk.stake_amount: None -> 0.1 (default_fill)\r\n    strategy.risk.max_position_pct: 0.3 -> None (strip_unknown)\r\n  Validation: PASS\r\n"]
[5.543057, "o", "  Freqtrade transpile: OK\r\n  Backtrader transpile: OK\r\n"]
[5.624831, "o", "\r\n"]
[5.624859, "o", ">>> Step 4: Risk Agent — Veto Power (LLM proposes, deterministic code disposes)\r\n----------------------------------------------------------------\r\n"]
[5.719819, "o", "  Case 1 (valid trade):     allow=False  position=0\r\n"]
[5.719888, "o", "  Case 2 (over limit 45%):   allow=False  vetoed_by=['stop_loss_distance']\r\n  Case 3 (no stop loss):     allow=False  vetoed_by=['stop_loss_distance']\r\n"]
[5.719913, "o", "  Case 4 (neutral view):     allow=False  position=0\r\n"]
[5.729156, "o", "\r\n>>> Step 5: RL Reward — 8-Dimensional Strategy Scoring\r\n"]
[5.729211, "o", "----------------------------------------------------------------\r\n"]
[5.820248, "o", "  Good strategy:  reward=0.570  grade=A\r\n    feedback: Alpha+8.00%跑赢基准；Sharpe 1.50风险调整收益优秀\r\n  Bad strategy:   reward=-0.120  grade=D\r\n    feedback: Alpha-5.00%跑输基准；Sharpe -0.50风险调整收益不足\r\n"]
